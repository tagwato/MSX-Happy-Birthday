10 REM --- FELIZ ANIVERSARIO NO MSX COM ACELERACAO ---
20 SCREEN 1,2: COLOR 15,4,4: CLS
30 KEY OFF: LOCATE 1,5: PRINT "Feliz Aniversario, Adriano!"
40 LOCATE 4,7: PRINT "MUITAS FELICIDADES!"
45 LOCATE 7,9: PRINT "(Com Sprites)"

50 REM --- ATIVA SPRITES 16X16 ---
60 VDP(1) = VDP(1) OR 1

70 REM --- GRAVA PADRAO DO BALAO NA VRAM ---
80 FOR I = 0 TO 31: READ B: VPOKE &H3800 + I, B: NEXT I
90 DATA &H01,&H07,&H0F,&H1F,&H3F,&H3F,&H3F,&H1F,&H0F,&H07,&H03,&H01,&H00,&H00,&H00,&H00
100 DATA &H80,&HE0,&HF0,&HF8,&HFC,&HFC,&HFC,&HF8,&HF0,&HE0,&HC0,&H80,&H40,&H20,&H10,&H08

110 REM --- MELODIAS (M1$ = NORMAL / M2$ = SEGUNDA VEZ ACELERADA) ---
120 M1$ = "T120O4G8G8A4G4O5C4O4B2G8G8A4G4O5D4C2G8G8O5G4E4C4O4B4A4O5F8F8E4C4D4C2"
130 M2$ = "T240O4G8G8A4G4O5C4O4B2G8G8A4G4O5D4C2G8G8O5G4E4C4O4B4A4O5F8F8E4C4D4C2"

140 REM --- VARIAVEIS INICIAIS ---
150 C = 0: V = 2
160 Y1 = 192: X1 = 80: Y2 = 230: X2 = 150
170 PLAY M1$

180 REM --- LOOP PRINCIPAL DE ANIMACAO ---
190 PUT SPRITE 0, (X1, Y1), 8, 0
200 PUT SPRITE 1, (X2, Y2), 3, 0

210 Y1 = Y1 - V: IF Y1 < -16 THEN Y1 = 192
220 Y2 = Y2 - V: IF Y2 < -16 THEN Y2 = 192

230 REM --- VERIFICA SE A MUSICA TERMINOU ---
240 IF PLAY(0) THEN 280
250 C = C + 1
260 IF C < 2 THEN V = 4: PLAY M2$: GOTO 280
270 GOTO 300

280 FOR T = 1 TO 20: NEXT T
290 GOTO 180

300 REM --- FINALIZACAO DO PROGRAMA ---
310 SOUND 8,0: SOUND 9,0: SOUND 10,0
320 LOCATE 2,13: PRINT "RUN OU F5 PARA VER DE NOVO"
330 END

